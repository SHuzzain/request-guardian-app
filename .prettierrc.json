{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "importOrder": [
    "^(react|react?/?([a-zA-Z/]*)$",
    "<THIRD_PARTY_MODULES>",
    "^@feature/(.*)$",
    "^@components/(.*)$",
    "^@layout/(.*)$",
    "^@pages/(.*)$",
    "^@routes/(.*)$",
    "^@hooks/(.*)$",
    "^@store/(.*)$",
    "^@config/(.*)$",
    "^@assets/(.*)$",
    "^@/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ]
}
